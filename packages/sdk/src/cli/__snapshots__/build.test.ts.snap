// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`planTarget generates the node files 1`] = `
{
  "bundleFile": "server.mjs",
  "entrySource": 
"// Generated by \`ryu build --target node\`. Do not edit; rebuild instead.
import * as project from "../../../src/ryu.ts";
import { resolveDeployedServer } from "@ryuhq/sdk/server";
import { serve } from "@ryuhq/sdk/server/node";

const server = resolveDeployedServer(project);
const port = Number(process.env.PORT ?? 3000);
const hostname = process.env.HOST ?? "0.0.0.0";
const app = await serve({ fetch: server.fetch, port, hostname });
process.stdout.write(\`ryu server listening on \${app.url}\${server.basePath}\\n\`);
const stop = () => {
	app.close().finally(() => process.exit(0));
};
process.once("SIGINT", stop);
process.once("SIGTERM", stop);
"
,
  "files": {
    "package.json": 
"{
  "name": "support-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ryuhq/sdk-native": "^0.4.0"
  }
}
"
,
  },
  "hint": "npm install && node server.mjs",
  "native": "external",
  "platform": "node",
}
`;

exports[`planTarget generates the docker files 1`] = `
{
  "bundleFile": "server.mjs",
  "entrySource": 
"// Generated by \`ryu build --target docker\`. Do not edit; rebuild instead.
import * as project from "../../../src/ryu.ts";
import { resolveDeployedServer } from "@ryuhq/sdk/server";
import { serve } from "@ryuhq/sdk/server/node";

const server = resolveDeployedServer(project);
const port = Number(process.env.PORT ?? 3000);
const hostname = process.env.HOST ?? "0.0.0.0";
const app = await serve({ fetch: server.fetch, port, hostname });
process.stdout.write(\`ryu server listening on \${app.url}\${server.basePath}\\n\`);
const stop = () => {
	app.close().finally(() => process.exit(0));
};
process.once("SIGINT", stop);
process.once("SIGTERM", stop);
"
,
  "files": {
    ".dockerignore": 
"node_modules
npm-debug.log
"
,
    "Dockerfile": 
"# Generated by \`ryu build --target docker\`. Do not edit; rebuild instead.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY server.mjs ./
USER node
EXPOSE 3000
CMD ["node", "server.mjs"]
"
,
    "package.json": 
"{
  "name": "support-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ryuhq/sdk-native": "^0.4.0"
  }
}
"
,
  },
  "hint": "docker build -t support-bot . && docker run -p 3000:3000 -e RYU_GATEWAY_URL support-bot",
  "native": "external",
  "platform": "node",
}
`;

