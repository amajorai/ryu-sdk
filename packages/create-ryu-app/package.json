{
  "name": "create-ryu-app",
  "version": "0.5.0",
  "type": "module",
  "description": "Scaffold a starter Ryu SDK project with a Runnable, gateway-pointed model config, and manifest.json manifest",
  "repository": {
    "type": "git",
    "url": "https://github.com/amajorai/ryu-sdk"
  },
  "bin": {
    "create-ryu-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "pretest": "bun run --cwd ../sdk build",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ryuhq/sdk": "workspace:*"
  },
  "devDependencies": {
    "@ryuhq/services": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "catalog:",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "zod": "catalog:"
  }
}
