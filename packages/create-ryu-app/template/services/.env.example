# Copy to .env (Bun loads it automatically) and fill in your own values.
# Keep .env out of version control.

# ── Read by @ryuhq/services ────────────────────────────────────────────────
# A ryu_ key with the mail:send scope, used by POST /mail.
RYU_API_KEY=
# The organization the ryu_ key acts for; required for personal keys.
RYU_ORGANIZATION_ID=
# Your Notify tenant key (hosted Notify keys are provisioned by Ryu), used by POST /notify.
RYU_NOTIFY_API_KEY=

# ── Read by this server (src/settings.ts) ──────────────────────────────────
# The ID of the inbox POST /mail sends from.
MAIL_FROM=
# The whsec_ signing secret of your Mail webhook (POST /webhooks/mail).
MAIL_WEBHOOK_SECRET=
# The secret of your Notify webhook destination (POST /webhooks/notify).
NOTIFY_WEBHOOK_SECRET=
# The port to listen on (default 3000; an empty value also means 3000).
# PORT=3000
