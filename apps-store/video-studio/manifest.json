      "description": "Read project timelines, imported media, and exported videos."
    },
    {
      "id": "video-studio.edit",
      "label": "Can edit",
      "description": "Import media, edit projects and storyboards, and start or cancel video exports.",
      "implies": ["video-studio.view"]
    },
    {
      "id": "video-studio.approve",
      "label": "Can approve scenes",
      "description": "Approve or reopen review of exact saved storyboard scenes and selected takes.",
