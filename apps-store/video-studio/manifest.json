    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "full"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "none"
    },
    "mobile": {
      "support": "none"
    },
    "extension": {
      "support": "none"
    },
    "web": {
      "support": "none"
    },
    "cli": {
      "support": "none"
    }
  },
  "permission_grants": [
    "app:http",
    "media:generate",
    "hook:side-model",
    "sidecar:process",
    "media:transcribe",
    "spaces:docs",
    "usage:read"
  ],
