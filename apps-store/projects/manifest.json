{
  "tags": ["projects", "tasks", "planning", "delivery", "operations"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-projects",
  "homepage": "https://github.com/amajorai/ryu-projects",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/projects",
  "name": "Projects",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Productivity",
  "description": "A durable coordinator workspace for turning long-running work into owned tasks, shared context, delegated workers, and recurring signals without replacing Ryu's CRM, Calendar, or Workflows.",
  "tagline": "Keep the work moving",
  "keywords": ["projects", "tasks", "planning", "delivery", "operations"],
  "icon": "task-01",
  "iconDither": { "from": 210, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "projects-companion",
      "name": "Projects",
      "kind": "companion",
      "config": {
        "label": "Projects",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    },
    {
      "id": "projects-run",
      "name": "Run Projects coordinator",
      "kind": "tool",
      "config": {
        "slug": "projects.run",
        "backend": "http",
        "method": "POST",
        "url": "core:/api/ext/@ryu/projects/tools/run",
        "secret_headers": { "Authorization": "Bearer env:RYU_TOKEN" },
        "fail_open": true,
        "unwrap_body": true,
        "description": "Dispatch one request to a durable Projects coordinator.",
        "input_schema": {
          "type": "object",
          "required": ["projectId", "prompt"],
          "properties": {
            "projectId": { "type": "string" },
            "prompt": { "type": "string" }
          }
        }
      }
    }
  ],
  "permission_grants": [
    "app:http",
    "tool:http-egress:127.0.0.1",
    "chat.sendFollowUp",
    "shell:integrate",
    "spaces:docs",
    "storage:kv",
    "ui:toast"
  ],
  "sidecars": [
    {
      "name": "projects",
      "process": {
        "kind": "local",
        "command": "ryu-projects",
        "command_env": "RYU_PROJECTS_BIN",
        "port_env": "RYU_PROJECTS_PORT"
      },
      "port": 8022,
      "health_path": "/health",
      "lazy": false,
      "http": {
        "mount": "/api/projects",
        "public_mount": "/api/projects",
        "max_body_bytes": 524288,
        "routes": [
          { "path": "/bootstrap", "method": "GET", "permission": "projects.view" },
          { "path": "/tools/run", "method": "POST", "permission": "projects.edit" },
          { "path": "/projects", "method": "GET", "permission": "projects.view" },
          { "path": "/projects", "method": "POST", "permission": "projects.edit" },
          { "path": "/projects/import", "method": "POST", "permission": "projects.edit" },
          { "path": "/projects/:id", "method": "GET", "permission": "projects.view" },
          { "path": "/projects/:id", "method": "PATCH", "permission": "projects.edit" },
          { "path": "/projects/:id", "method": "DELETE", "permission": "projects.edit" },
          { "path": "/projects/:id/run", "method": "POST", "permission": "projects.edit" },
          { "path": "/projects/:id/context", "method": "GET", "permission": "projects.view" },
          { "path": "/projects/:id/context", "method": "POST", "permission": "projects.edit" },
          { "path": "/projects/:id/context/:context_id", "method": "PATCH", "permission": "projects.edit" },
          { "path": "/projects/:id/context/:context_id", "method": "DELETE", "permission": "projects.edit" },
          { "path": "/projects/:id/workers", "method": "GET", "permission": "projects.view" },
          { "path": "/projects/:id/workers", "method": "POST", "permission": "projects.edit" },
          { "path": "/projects/:id/subscriptions", "method": "GET", "permission": "projects.view" },
          { "path": "/projects/:id/subscriptions", "method": "POST", "permission": "projects.edit" },
          { "path": "/projects/:id/subscriptions/:subscription_id", "method": "PATCH", "permission": "projects.edit" },
          { "path": "/projects/:id/subscriptions/:subscription_id", "method": "DELETE", "permission": "projects.edit" },
          { "path": "/events/:source", "method": "POST", "permission": "projects.edit" }
        ]
      },
      "host_api": {
        "grants": ["chat.sendFollowUp"]
      }
    }
  ],
  "permission_levels": [
    {
      "id": "projects.view",
      "label": "Can view",
      "description": "See projects, owners, due dates, and task progress."
    },
    {
      "id": "projects.edit",
      "label": "Can edit",
      "description": "Create projects, add tasks, update delivery status, dispatch coordinator work, and manage subscriptions.",
      "implies": ["projects.view"]
    }
  ],
  "companion": { "label": "Projects", "icon": "task-01" }
}
