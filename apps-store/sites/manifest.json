{
  "tags": [
    "sites",
    "publishing",
    "hosting",
    "domains",
    "public edge"
  ],
  "author": {
    "name": "Ryu",
    "url": "https://ryuhq.com"
  },
  "repository": "https://github.com/amajorai/ryu-sites",
  "homepage": "https://github.com/amajorai/ryu-sites",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/sites",
  "name": "Sites",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Developer Tools",
  "description": "Create, refine, save and deploy websites with private access, browser-local data and scoped Ryu capabilities.",
  "tagline": "Build websites on Ryu",
  "keywords": [
    "sites",
    "publishing",
    "hosting",
    "domains",
    "public edge",
    "widgets"
  ],
  "icon": "browser",
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "none"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "none"
    },
    "mobile": {
      "support": "none"
    },
    "extension": {
      "support": "none"
    },
    "web": {
      "support": "none"
    },
    "cli": {
      "support": "none"
    }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "sites-companion",
      "name": "Sites",
      "kind": "companion",
      "config": {
        "label": "Sites",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": [
    "app:http",
    "hook:side-model",
    "spaces:docs",
    "identity:read",
    "security:check"
  ],
  "companion": {
    "label": "Sites",
    "icon": "browser"
  },
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "sites-projects",
        "title": "Sites",
        "icon": "activity-03",
        "target": "/plugin/app__sites-companion",
        "context": {
          "view": "projects"
        },
        "order": 71
      }
    ]
  },
  "sidecars": [
    {
      "name": "sites",
      "process": {
        "kind": "local",
        "command": "ryu-sites",
        "command_env": "RYU_SITES_BIN",
        "port_env": "RYU_SITES_PORT"
      },
      "port": 8021,
      "health_path": "/health",
      "lazy": false,
      "http": {
        "mount": "/api/sites",
        "public_mount": "/api/sites",
        "routes": [
          {
            "path": "/status",
            "permission": "sites.manage"
          },
          {
            "path": "/runtime",
            "permission": "sites.manage"
          },
          {
            "path": "/projects",
            "permission": "sites.manage"
          },
          {
            "path": "/projects/:id",
            "permission": "sites.manage"
          },
          {
            "path": "/projects/:id/:action",
            "permission": "sites.manage"
          },
          {
            "path": "/projects/:id/versions/:version",
            "permission": "sites.manage"
          },
          {
            "path": "/projects/:id/domains/check",
            "permission": "sites.manage"
          }
        ]
      },
      "host_api": {
        "grants": [
          "spaces:docs",
          "hook:side-model",
          "identity:read",
          "security:check"
        ]
      }
    }
  ],
  "permission_levels": [
    {
      "id": "sites.manage",
      "label": "Manage sites",
      "description": "Create and edit sites, configure their visitor access, save versions and change deployments."
    }
  ]
}
