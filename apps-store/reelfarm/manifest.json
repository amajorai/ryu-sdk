{
  "tags": [
    "tiktok",
    "reels",
    "automation",
    "slideshow",
    "content",
    "analytics"
  ],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-reelfarm",
  "homepage": "https://github.com/amajorai/ryu-reelfarm",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/studio",
  "name": "Studio",
  "version": "0.2.0",
  "stability": "experimental",
  "description": "A local-first content queue for short-form ideas, hooks, visual direction, and planned publish slots.",
  "tagline": "Keep the good ideas moving",
  "keywords": [
    "tiktok",
    "reels",
    "automation",
    "slideshow",
    "content",
    "analytics"
  ],
  "category": "Creative",
  "icon": "film-01",
  "iconDither": { "from": 198, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "none" },
    "mobile": { "support": "none" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "studio-companion",
      "name": "Studio",
      "kind": "companion",
      "config": {
        "label": "Studio",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["storage:kv", "hook:side-model"],
  "permission_levels": [
    {
      "id": "studio.view",
      "label": "Can view",
      "description": "Browse the local short-form content queue."
    },
    {
      "id": "studio.manage",
      "label": "Can manage",
      "description": "Create, edit, plan, favorite, import, and remove content ideas.",
      "implies": ["studio.view"]
    },
    {
      "id": "studio.generate",
      "label": "Can generate",
      "description": "Use Ryu's configured model to draft short-form ideas from a brief.",
      "implies": ["studio.manage"]
    }
  ]
}
